# ==========================================
# Root .gitignore for Family Tree Project
# ==========================================

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor & IDE Files
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Python / Flask (Backend)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/build/
backend/develop-eggs/
backend/dist/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/

# Flask Instance & SQLite Databases
instance/
backend/instance/
*.db
*.sqlite
*.sqlite3
.webassets-cache

# Testing & Coverage (Python)
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Node.js & React (Frontend)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary Files & Caches
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
